# Só a ferramenta vai para o repositório. Tudo o mais é ignorado por padrão,
# inclusive os testes gravados, credenciais, prints e resultados.
*

!.gitignore
!.gitattributes
!README.md
!iniciar.bat
!iniciar.sh
!package.json
!package-lock.json
!playwright.config.ts
!servidor.js
!roteiro.html

!tests/
!tests/e2e/
tests/e2e/*
!tests/e2e/gravados/
tests/e2e/gravados/*
!tests/e2e/gravados/.gitkeep
